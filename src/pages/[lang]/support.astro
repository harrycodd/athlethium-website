---
import Support from '../../components/Support.astro';
import { defaultLang, langs, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return langs.filter((lang) => lang !== defaultLang).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Support lang={lang} />
