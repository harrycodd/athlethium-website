    <script>
      // Light mode toggle logic
      const toggleBtn = document.getElementById('lightToggle');
      const themeIcon = document.getElementById('themeIcon');
      const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
      const saved = localStorage.getItem('athlethium-theme');
      
      function updateTheme(isLight) {
        if (isLight) {
          document.body.classList.add('light');
          // Switch to moon icon for light mode, keeping the gradient
          themeIcon.innerHTML = `
            <path stroke="url(#themeIconGradient)" fill="url(#themeIconGradient)" d="M21 12.79A9 9 0 1 1 11.21 3 A7 7 0 0 0 21 12.79z"></path>
          `;
        } else {
          document.body.classList.remove('light');
          // Switch to sun icon for dark mode with a more sun-like appearance
          themeIcon.innerHTML = `
            <circle cx="12" cy="12" r="4" stroke="url(#themeIconGradient)" fill="url(#themeIconGradient)"></circle>
            <path stroke="url(#themeIconGradient)" d="M12 2v2M12 20v2M4 12H2M22 12h-2M6 6l1.4 1.4M17.6 17.6l1.4 1.4M6 18l1.4-1.4M17.6 6.4l1.4-1.4" stroke-width="2"></path>
          `;
        }
        
        // Update header appearance based on current theme
        updateHeaderAppearance();
      }
      
      // Initialize theme
      updateTheme((saved === 'light') || (!saved && prefersLight));
      
      // Toggle theme on click
      toggleBtn.addEventListener('click', () => {
        const isLight = document.body.classList.toggle('light');
        localStorage.setItem('athlethium-theme', isLight ? 'light' : 'dark');
        updateTheme(isLight);
      });
      
      // Add animation classes to feature cards
      document.querySelectorAll('.feature-card').forEach((card, index) => {
        card.style.setProperty('--index', index + 1);
      });
      
      // Function to update header appearance
      function updateHeaderAppearance() {
        const header = document.querySelector('.header');
        const isLight = document.body.classList.contains('light');
        const isScrolled = window.scrollY > 100;
        
        header.style.boxShadow = isScrolled ? 
          '0 10px 30px rgba(0,0,0,0.2)' : 
          '0 4px 24px rgba(0,0,0,0.15)';
        
        header.style.background = isLight ? 
          (isScrolled ? 'rgba(247, 250, 255, 0.95)' : 'rgba(247, 250, 255, 0.85)') : 
          (isScrolled ? 'rgba(14, 18, 28, 0.95)' : 'rgba(14, 18, 28, 0.85)');
      }
      
      // Header scroll effect
      window.addEventListener('scroll', updateHeaderAppearance);
      
      // Initial header setup
      updateHeaderAppearance();
    </script>
