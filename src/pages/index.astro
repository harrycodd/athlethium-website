---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Athlethium</title>
    <meta name="description" content="Affordable, AI-powered adaptive coaching for endurance athletes. Experience a natural coach-like experience with truly personalized, polarized training plans." />
    <link rel="icon" type="image/png" href="/logo.png" />
    <style>
      :root {
        --primary: #2563ff;
        --primary-dark: #1a47b8;
        --accent: #6c63ff;
        --background-dark: #101114;
        --background-light: #f5f8fc;
        --card-dark: #181b22;
        --card-light: #f5f8fc;
        --text-dark: #fff;
        --text-light: #181b22;
        --border-radius: 18px;
        --shadow: 0 4px 24px 0 rgba(0,0,0,0.10);
      }

      body {
        background: linear-gradient(120deg, #101114 60%, #23263a 100%);
        color: var(--text-dark);
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        font-weight: 500;
        min-height: 100vh;
        margin: 0;
        padding: 0;
        transition: background 0.3s, color 0.3s;
        position: relative;
        overflow-x: hidden;
      }
      body::before {
        content: '';
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        pointer-events: none;
        background: url('data:image/svg+xml;utf8,<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="1.5" fill="%232563ff" fill-opacity="0.06"/></svg>');
        opacity: 0.25;
        z-index: 0;
      }

      .header {
        background: rgba(24, 27, 34, 0.92);
        border-radius: 16px;
        box-shadow: 0 2px 12px 0 rgba(37,99,255,0.10), var(--shadow);
        margin: 32px 32px 0 32px;
        padding: 0 22px 0 12px;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        width: auto;
        transform: none;
        z-index: 100;
        height: 60px;
        min-width: unset;
        max-width: unset;
        backdrop-filter: blur(4px) saturate(1.1);
        border: 1px solid rgba(37,99,255,0.07);
        transition: box-shadow 0.2s, background 0.2s, transform 0.2s;
      }
      @media (max-width: 900px) {
        .header {
          margin: 18px 6px 0 6px;
        }
      }
      .header-content {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        height: 100%;
        position: relative;
      }
      .logo {
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        height: 36px;
        width: 36px;
        margin: 0;
        display: block;
        filter: drop-shadow(0 1px 4px rgba(37,99,255,0.08));
      }
      .site-title {
        position: relative;
        left: 0;
        top: 0;
        transform: none;
        font-size: 1.7rem;
        font-weight: 800;
        color: var(--text-dark);
        letter-spacing: -0.01em;
        background: linear-gradient(90deg, var(--primary), var(--accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-left: 0;
        user-select: none;
        white-space: nowrap;
        text-align: center;
        flex: 1;
      }
      .light-toggle {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        margin-left: 0;
        margin-right: 0;
      }

      .main-content {
        max-width: 700px;
        margin: 90px auto 0 auto;
        padding: 0 18px 36px 18px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
        position: relative;
        z-index: 1;
      }

      .download-buttons {
        display: flex;
        flex-direction: row;
        gap: 16px;
        justify-content: center;
        align-items: center;
        margin-bottom: 64px;
        margin-top: 48px;
        width: 100%;
      }

      .download-btn {
        background: var(--primary);
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
        border: none;
        border-radius: 10px;
        padding: 12px 20px;
        box-shadow: 0 2px 8px 0 rgba(37,99,255,0.08), var(--shadow);
        transition: background 0.18s, box-shadow 0.18s, transform 0.12s;
        cursor: pointer;
        outline: none;
        margin-bottom: 0;
        text-decoration: none;
        letter-spacing: 0.01em;
      }
      .download-btn:hover {
        background: var(--primary-dark);
        box-shadow: 0 4px 16px 0 rgba(37,99,255,0.13);
        transform: scale(1.025);
      }

      h1 {
        font-size: 2.1rem;
        text-align: center;
        margin-bottom: 0.5em;
        background: linear-gradient(90deg, var(--primary), var(--accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        width: 100%;
      }

      .feature-cards {
        display: flex;
        flex-direction: row;
        gap: 32px;
        width: 100%;
        max-width: 1800px;
        margin: 0 auto;
        flex-wrap: wrap;
        justify-content: center;
      }
      @media (max-width: 900px) {
        .feature-cards {
          flex-direction: column;
          gap: 20px;
        }
      }
      .feature-card {
        background: rgba(24, 27, 34, 0.98);
        border-radius: 16px;
        box-shadow: 0 1px 8px 0 rgba(37,99,255,0.07), var(--shadow);
        padding: 38px 48px 32px 48px;
        color: var(--text-dark);
        font-size: 1.18rem;
        font-weight: 500;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 28px;
        border: 1px solid rgba(37,99,255,0.05);
        transition: box-shadow 0.13s, transform 0.13s;
        position: relative;
        overflow: hidden;
        min-width: 340px;
        max-width: 700px;
        width: 100%;
        min-height: 120px;
      }
      @media (max-width: 900px) {
        .feature-card {
          flex-direction: column;
          align-items: flex-start;
          padding: 18px 8px 14px 8px;
          font-size: 1.05rem;
          min-width: 0;
          max-width: 100%;
        }
      }
      .feature-card:hover {
        box-shadow: 0 8px 32px 0 rgba(37,99,255,0.13), var(--shadow);
        transform: translateY(-2px) scale(1.018);
      }
      .feature-icon {
        font-size: 2.6rem;
        margin-bottom: 0;
        color: var(--primary);
        filter: drop-shadow(0 2px 8px rgba(37,99,255,0.10));
        flex-shrink: 0;
      }
      @media (max-width: 900px) {
        .feature-icon {
          font-size: 2.1rem;
        }
      }
      .feature-card h2 {
        margin: 0 0 8px 0;
        font-size: 1.25rem;
      }
      .feature-card p {
        margin: 0;
        font-size: 1.08rem;
        font-weight: 400;
      }
      .feature-card > div {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      h2 {
        font-size: 1.08rem;
      }

      @media (max-width: 600px) {
        .header {
          height: 44px;
          padding: 0 10px 0 4px;
        }
        .header-content {
          max-width: 100vw;
        }
        .logo {
          height: 24px;
          width: 24px;
        }
        .site-title {
          font-size: 1.05rem;
        }
        .main-content {
          margin-top: 60px;
        }
        .feature-card {
          padding: 10px 6px 8px 6px;
        }
        .download-btn {
          padding: 8px 6px;
          font-size: 0.95rem;
        }
      }

      @media (min-width: 900px) {
        .main-content {
          flex-direction: column;
          align-items: center;
          max-width: 700px;
          margin-top: 90px;
          gap: 32px;
        }
        .main-content > .download-buttons {
          flex-direction: row;
          gap: 16px;
          align-items: center;
          justify-content: center;
          margin-right: 0;
          margin-bottom: 0;
          width: 100%;
        }
        .main-content > .feature-cards {
          flex-direction: row;
          gap: 28px;
          justify-content: center;
          width: 100%;
        }
        .header {
          height: 60px;
          padding: 0 22px 0 12px;
        }
        .header-content {
          max-width: 1100px;
        }
        .logo {
          height: 36px;
          width: 36px;
        }
        .site-title {
          font-size: 1.7rem;
        }
      }

      /* Light mode support */
      body.light {
        background: var(--background-light);
        color: var(--text-light);
      }
      body.light .header {
        background: rgba(245, 248, 252, 0.92);
        box-shadow: 0 2px 12px 0 rgba(37,99,255,0.07), var(--shadow);
        border: 1px solid rgba(37,99,255,0.04);
      }
      body.light .site-title {
        color: var(--text-light);
        background: linear-gradient(90deg, var(--primary), var(--accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      body.light .feature-card {
        background: var(--card-light);
        color: var(--text-light);
        border: 1px solid rgba(37,99,255,0.04);
      }
      body.light .download-btn {
        background: var(--accent);
        color: #fff;
      }
      body.light .download-btn:hover {
        background: var(--primary);
      }
      body.light .main-content {
        color: var(--text-light);
      }
      body.light h1, body.light h2, body.light h3, body.light h4 {
        color: var(--text-light);
      }
      body.light footer {
        color: #4a4a4a;
      }
      /* Light mode toggle button */
      .light-toggle {
        margin-left: 0;
        margin-right: 0;
        margin-left: auto;
        background: none;
        border: none;
        color: var(--text-dark);
        font-size: 1.2rem;
        cursor: pointer;
        transition: color 0.2s;
        padding: 4px 8px;
        border-radius: 6px;
      }
      .light-toggle:hover {
        color: var(--primary);
        background: rgba(37,99,255,0.07);
      }
      body.light .light-toggle {
        color: var(--text-light);
      }
      body.light .light-toggle:hover {
        color: var(--primary);
        background: rgba(37,99,255,0.10);
      }

      footer {
        text-align: center;
        color: #bfc7e0;
        font-size: 0.98rem;
        margin: 36px 0 10px 0;
        opacity: 0.7;
        letter-spacing: 0.01em;
      }
    </style>
  </head>
  <body>
    <header class="header">
      <div class="header-content">
        <img src="/logo.png" alt="Athlethium Logo" class="logo" />
        <span class="site-title">Athlethium</span>
        <button class="light-toggle" id="lightToggle" title="Toggle light/dark mode">🌙</button>
      </div>
    </header>
    <main class="main-content">
      <div class="download-buttons">
        <a href="https://testflight.apple.com/join/TWZFZYwX" class="download-btn testflight" target="_blank">Download on TestFlight (iOS)</a>
        <a href="https://github.com/harrycodd/androidAppRepo/releases/download/Athlethium/athlethium-beta.apk" class="download-btn apk" target="_blank">Download APK (Android)</a>
      </div>
      <h1>Adaptive Coaching for Endurance Athletes</h1>
      <div class="feature-cards">
        <div class="feature-card">
          <span class="feature-icon" aria-hidden="true">⚡️</span>
          <div>
            <h2>Truly Adaptive</h2>
            <p>Your training plan evolves with you. Athlethium analyzes your progress and feedback, updating your workouts in real time for optimal results.</p>
          </div>
        </div>
        <div class="feature-card">
          <span class="feature-icon" aria-hidden="true">🏃‍♂️</span>
          <div>
            <h2>Polarized Training</h2>
            <p>Unlike other apps, we use a proven polarized model balancing intensity and recovery for maximum endurance gains and injury prevention.</p>
          </div>
        </div>
        <div class="feature-card">
          <span class="feature-icon" aria-hidden="true">🤖</span>
          <div>
            <h2>Structured Algorithm + AI</h2>
            <p>Combining structured algorithms with LLMs, Athlethium delivers both reliable and flexible training, with human-like coaching conversations.</p>
          </div>
        </div>
        <div class="feature-card">
          <span class="feature-icon" aria-hidden="true">💸</span>
          <div>
            <h2>Affordable for All</h2>
            <p>Get world-class, adaptive coaching at a fraction of the cost of traditional coaching, with no compromises.</p>
          </div>
        </div>
      </div>
    </main>
    <footer>
      &copy; 2025 Athlethium. All rights reserved.
    </footer>
    <script>
      // Light mode toggle logic
      const toggleBtn = document.getElementById('lightToggle');
      const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
      const saved = localStorage.getItem('athlethium-theme');
      if ((saved === 'light') || (!saved && prefersLight)) {
        document.body.classList.add('light');
        toggleBtn.textContent = '🌙';
      } else {
        toggleBtn.textContent = '☀️';
      }
      toggleBtn.addEventListener('click', () => {
        document.body.classList.toggle('light');
        if (document.body.classList.contains('light')) {
          localStorage.setItem('athlethium-theme', 'light');
          toggleBtn.textContent = '🌙';
        } else {
          localStorage.setItem('athlethium-theme', 'dark');
          toggleBtn.textContent = '☀️';
        }
      });
    </script>
  </body>
</html>
