---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Athlethium</title>
    <meta name="description" content="Affordable, AI-powered adaptive coaching for endurance athletes. Experience a natural coach-like experience with truly personalized, polarized training plans." />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      :root {
        --primary: #2563ff;
        --primary-dark: #1a47b8;
        --accent: #6c63ff;
        --accent-secondary: #4F46E5;
        --background-dark: #0a0c12;
        --background-light: #f7faff;
        --card-dark: #141824;
        --card-light: #ffffff;
        --text-dark: #fff;
        --text-light: #0f172a;
        --text-muted-dark: rgba(255, 255, 255, 0.7);
        --text-muted-light: rgba(15, 23, 42, 0.7);
        --border-radius: 18px;
        --shadow: 0 8px 32px -4px rgba(0,0,0,0.15);
        --gradient-primary: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: linear-gradient(145deg, var(--background-dark) 0%, #131726 100%);
        color: var(--text-dark);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-weight: 400;
        min-height: 100vh;
        margin: 0;
        padding: 0;
        transition: background 0.3s, color 0.3s;
        position: relative;
        overflow-x: hidden;
        line-height: 1.6;
        letter-spacing: -0.01em;
      }
      
      body::before {
        content: '';
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: 
          radial-gradient(circle at 15% 25%, rgba(37,99,255,0.07) 0%, transparent 25%),
          radial-gradient(circle at 85% 75%, rgba(108,99,255,0.05) 0%, transparent 30%),
          url('data:image/svg+xml;utf8,<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="1" fill="%232563ff" fill-opacity="0.07"/></svg>');
        opacity: 1;
        z-index: 0;
        pointer-events: none;
      }

      .header {
        background: rgba(14, 18, 28, 0.85);
        border-radius: 20px;
        box-shadow: 0 4px 24px 0 rgba(0,0,0,0.15);
        margin: 20px 24px 0;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        width: auto;
        z-index: 100;
        height: 70px;
        backdrop-filter: blur(10px) saturate(1.2);
        border: 1px solid rgba(37,99,255,0.08);
        transition: all 0.3s ease;
      }
      
      @media (max-width: 900px) {
        .header {
          margin: 16px 16px 0;
          height: 60px;
          border-radius: 16px;
          padding: 0 16px;
        }
        .header-content {
          max-width: 100%;
        }
        .logo {
          height: 36px;
          width: 36px;
        }
        .site-title {
          font-size: 1.3rem;
          margin-left: 12px;
        }
        .main-content {
          margin-top: 100px;
          padding: 0 16px;
        }
      }

      .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        height: 100%;
      }
      
      .logo-container {
        position: relative;
        display: flex;
        align-items: center;
      }
      
      .logo {
        width: 42px;
        height: 42px;
        margin-right: 12px;
        background: var(--gradient-primary);
        -webkit-mask: url('/logo.png') no-repeat center / contain;
        mask: url('/logo.png') no-repeat center / contain;
        transition: transform 0.3s;
      }
      
      .site-title {
        font-size: 1.8rem;
        font-weight: 800;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        user-select: none;
        letter-spacing: -0.03em;
      }

      .light-toggle {
        background: transparent;
        border: none;
        padding: 8px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        outline: none;
        position: relative;
      }
      
      .light-toggle::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--gradient-primary);
        opacity: 0;
        transition: opacity 0.2s;
      }
      
      .light-toggle:hover::before {
        opacity: 0.15;
      }
      
      .light-toggle:hover {
        transform: translateY(-2px) rotate(10deg);
      }
      
      .light-toggle svg {
        width: 22px;
        height: 22px;
        fill: url(#themeIconGradient);
        stroke: url(#themeIconGradient);
        z-index: 1;
      }

      .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0 20px;
        margin-top: 150px;
        margin-bottom: 60px;
        position: relative;
        z-index: 1;
      }
      
      .hero-title {
        font-size: clamp(2rem, 5vw, 3.2rem);
        font-weight: 800;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.2;
        margin-bottom: 24px;
        letter-spacing: -0.03em;
        max-width: 720px;
      }
      
      .hero-description {
        font-size: clamp(1.1rem, 3vw, 1.3rem);
        max-width: 700px;
        margin-bottom: 40px;
        color: var(--text-muted-dark);
        font-weight: 400;
      }

      .download-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        justify-content: center;
        align-items: center;
        margin-bottom: 40px;
        width: 100%;
        max-width: 600px;
      }

      .download-btn {
        background: var(--gradient-primary);
        color: #fff;
        font-weight: 600;
        font-size: 1.1rem;
        border: none;
        border-radius: 14px;
        padding: 16px 28px;
        box-shadow: 0 4px 20px 0 rgba(37,99,255,0.25);
        transition: all 0.25s;
        cursor: pointer;
        outline: none;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      
      .download-btn:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 8px 30px 0 rgba(37,99,255,0.35);
      }
      
      .download-btn:active {
        transform: translateY(1px);
      }
      
      .download-btn svg {
        width: 22px;
        height: 22px;
        flex-shrink: 0;
      }
      
      .download-btn.testflight {
        background: linear-gradient(135deg, #0077e6 0%, #5ac8fa 100%);
      }
      
      .download-btn.apk {
        background: linear-gradient(135deg, #78c257 0%, #3ddc84 100%);
      }

      .main-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px 60px;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 1;
      }

      .section-title {
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        font-weight: 700;
        margin-bottom: 12px;
        text-align: center;
        position: relative;
        padding-bottom: 16px;
        letter-spacing: -0.02em;
      }
      
      .section-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 80px;
        height: 4px;
        background: var(--gradient-primary);
        border-radius: 4px;
      }
      
      .section-description {
        text-align: center;
        max-width: 700px;
        margin: 0 auto 40px;
        color: var(--text-muted-dark);
        font-size: 1.1rem;
      }

      .feature-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        width: 100%;
      }
      
      .feature-card {
        background: rgba(20, 24, 36, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 32px;
        color: var(--text-dark);
        display: flex;
        flex-direction: column;
        gap: 20px;
        border: 1px solid rgba(37,99,255,0.08);
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
      }
      
      .feature-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.2);
        border-color: rgba(37,99,255,0.15);
      }
      
      .feature-card::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--gradient-primary);
        opacity: 0;
        transition: opacity 0.3s;
      }
      
      .feature-card:hover::after {
        opacity: 1;
      }
      
      .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 8px;
        display: inline-block;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .feature-icon svg {
        width: 48px;
        height: 48px;
        fill: url(#featureIconGradient);
      }
      
      /* Additional style for emoji icons */
      .emoji-icon {
        font-size: 2.5rem;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      /* Additional style for image icons */
      .image-icon {
        width: 48px;
        height: 48px;
        display: inline-block;
        background: var(--gradient-primary);
      }
      
      .brain-icon {
        -webkit-mask: url('/brain.png') no-repeat center / contain;
        mask: url('/brain.png') no-repeat center / contain;
      }
      
      .money-icon {
        -webkit-mask: url('/money.png') no-repeat center / contain;
        mask: url('/money.png') no-repeat center / contain;
      }

      .feature-card h2 {
        font-size: 1.4rem;
        margin: 0;
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      
      .feature-card p {
        margin: 0;
        font-size: 1.05rem;
        color: var(--text-muted-dark);
        line-height: 1.6;
      }

      footer {
        padding: 36px 24px;
        font-size: 0.95rem;
        text-align: center;
        background: rgba(14, 18, 28, 0.8);
        color: var(--text-muted-dark);
        backdrop-filter: blur(10px);
        margin-top: 80px;
        border-top: 1px solid rgba(37,99,255,0.08);
      }
      
      .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      
      .social-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 20px;
      }
      
      .social-link {
        color: var(--text-muted-dark);
        font-size: 1.5rem;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
      }
      
      .social-link svg {
        width: 24px;
        height: 24px;
        fill: currentColor;
      }

      /* Light mode support */
      body.light {
        background: linear-gradient(145deg, #f0f5ff 0%, var(--background-light) 100%);
        color: var(--text-light);
      }
      
      body.light::before {
        background: 
          radial-gradient(circle at 15% 25%, rgba(37,99,255,0.05) 0%, transparent 25%),
          radial-gradient(circle at 85% 75%, rgba(108,99,255,0.03) 0%, transparent 30%),
          url('data:image/svg+xml;utf8,<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="1" fill="%232563ff" fill-opacity="0.05"/></svg>');
      }
      
      body.light .header {
        background: rgba(247, 250, 255, 0.85);
        border: 1px solid rgba(37,99,255,0.08);
      }
      
      body.light .light-toggle {
        color: var(--text-light);
      }
      
      body.light .light-toggle:hover {
        color: var(--primary);
      }
      
      body.light .light-toggle svg {
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      
      body.light .feature-card {
        background: rgba(255, 255, 255, 0.8);
        color: var(--text-light);
      }
      
      body.light .feature-card p {
        color: var(--text-muted-light);
      }
      
      body.light footer {
        background: rgba(247, 250, 255, 0.8);
        color: var(--text-muted-light);
      }
      
      body.light .social-link {
        color: var(--text-muted-light);
      }
      
      body.light .hero-description {
        color: var(--text-muted-light);
      }
      
      body.light .section-description {
        color: var(--text-muted-light);
      }

      @media (max-width: 768px) {
        .hero {
          margin-top: 120px;
          margin-bottom: 40px;
        }
        
        .download-buttons {
          flex-direction: column;
          width: 100%;
        }
        
        .download-btn {
          width: 100%;
          justify-content: center;
        }
        
        .feature-card {
          padding: 24px;
        }
        
        .feature-icon {
          font-size: 2.5rem;
        }
        
        .feature-icon svg {
          width: 40px;
          height: 40px;
        }
        
        .image-icon {
          width: 40px;
          height: 40px;
        }
        
        .feature-card h2 {
          font-size: 1.25rem;
        }
        
        .feature-card p {
          font-size: 1rem;
        }
      }

      /* Animations */
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      .hero-title, .hero-description, .download-buttons {
        animation: fadeInUp 0.8s ease backwards;
      }
      
      .hero-description {
        animation-delay: 0.2s;
      }
      
      .download-buttons {
        animation-delay: 0.4s;
      }
      
      .feature-card {
        animation: fadeInUp 0.8s ease backwards;
        animation-delay: calc(0.1s * var(--index, 0));
      }
      
      /* Make scrolling smooth */
      html {
        scroll-behavior: smooth;
        scrollbar-width: thin;
        scrollbar-color: var(--primary) rgba(0,0,0,0.1);
      }
      
      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 10px;
      }
      
      ::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.1);
      }
      
      ::-webkit-scrollbar-thumb {
        background: var(--primary);
        border-radius: 10px;
      }
      
      ::-webkit-scrollbar-thumb:hover {
        background: var(--primary-dark);
      }
    </style>
  </head>
  <body>
    <!-- Add SVG gradient definition -->
    <svg width="0" height="0" style="position: absolute;">
      <defs>
        <linearGradient id="themeIconGradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--primary)" />
          <stop offset="100%" stop-color="var(--accent)" />
        </linearGradient>
        <linearGradient id="featureIconGradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--primary)" />
          <stop offset="100%" stop-color="var(--accent)" />
        </linearGradient>
        <mask id="svgMask">
          <rect width="100%" height="100%" fill="white" />
        </mask>
      </defs>
    </svg>
    
    <header class="header">
      <div class="header-content">
        <div class="logo-container">
          <div class="logo" aria-label="Athlethium Logo"></div>
          <span class="site-title">Athlethium</span>
        </div>
        <button class="light-toggle" id="lightToggle" title="Toggle light/dark mode">
          <svg id="themeIcon" xmlns="http://www.w3.org/2000/svg"
               width="24" height="24" viewBox="0 0 24 24"
               fill="url(#themeIconGradient)" stroke="none">
            <circle cx="12" cy="12" r="5"/>
            <g stroke="url(#themeIconGradient)" stroke-width="2">
              <line x1="12" y1="1" x2="12" y2="4"/>
              <line x1="12" y1="20" x2="12" y2="23"/>
              <line x1="1"  y1="12" x2="4"  y2="12"/>
              <line x1="20" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="4.22" x2="6.34" y2="6.34"/>
              <line x1="17.66" y1="17.66" x2="19.78" y2="19.78"/>
              <line x1="4.22" y1="19.78" x2="6.34" y2="17.66"/>
              <line x1="17.66" y1="6.34" x2="19.78" y2="4.22"/>
            </g>
          </svg>
        </button>
      </div>
    </header>
    
    <section class="hero">
      <h1 class="hero-title">Adaptive Coaching for Endurance Athletes</h1>
      <p class="hero-description">Experience personalized training that evolves with you. Affordable, intelligent, and designed specifically for runners, cyclists, and triathletes.</p>
      <div class="download-buttons">
        <a href="https://testflight.apple.com/join/TWZFZYwX" class="download-btn testflight" target="_blank">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.64 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          Download for iOS
        </a>
        <a href="https://github.com/harrycodd/androidAppRepo/releases/download/Athlethium/athlethium-beta.apk" class="download-btn apk" target="_blank">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <!-- Android robot icon -->
            <path d="M6,18c0,0.55 0.45,1 1,1h1v3.5c0,0.83 0.67,1.5 1.5,1.5s1.5,-0.67 1.5,-1.5L11,19h2v3.5c0,0.83 0.67,1.5 1.5,1.5s1.5,-0.67 1.5,-1.5L16,19h1c0.55,0 1,-0.45 1,-1L18,8L6,8L6,18zM3.5,8C2.67,8 2,8.67 2,9.5v7c0,0.83 0.67,1.5 1.5,1.5S5,17.33 5,16.5v-7C5,8.67 4.33,8 3.5,8zM20.5,8c-0.83,0 -1.5,0.67 -1.5,1.5v7c0,0.83 0.67,1.5 1.5,1.5s1.5,-0.67 1.5,-1.5v-7c0,-0.83 -0.67,-1.5 -1.5,-1.5zM15.53,2.16l1.3,-1.3c0.2,-0.2 0.2,-0.51 0,-0.71s-0.51,-0.2 -0.71,0l-1.48,1.48C13.85,1.23 12.95,1 12,1c-0.96,0 -1.86,0.23 -2.66,0.63L7.85,0.15c-0.2,-0.2 -0.51,-0.2 -0.71,0s-0.2,0.51 0,0.71l1.31,1.31C6.97,3.26 6,5.01 6,7h12c0,-1.99 -0.97,-3.75 -2.47,-4.84zM10,5L9,5L9,4h1L10,5zM15,5h-1L14,4h1L15,5z"/>
          </svg>
          Download for Android
        </a>
      </div>
    </section>
    
    <main class="main-content">
      <h2 class="section-title">What Makes Us Different</h2>
      <p class="section-description">Athlethium combines cutting-edge technology with proven training methodologies to deliver a coaching experience that's both effective and affordable.</p>
      
      <div class="feature-cards">
        <div class="feature-card" style="--index: 1">
          <span class="feature-icon emoji-icon" aria-hidden="true">
            ⚡
          </span>
          <h2>Truly Adaptive</h2>
          <p>Your training plan evolves with you. Athlethium analyzes your progress and feedback, updating your workouts in real time for optimal results.</p>
        </div>
        <div class="feature-card" style="--index: 2">
          <span class="feature-icon emoji-icon" aria-hidden="true">
            🏃‍♂️
          </span>
          <h2>Polarized Training</h2>
          <p>Unlike other apps, we use a proven polarized model balancing intensity and recovery for maximum endurance gains and injury prevention.</p>
        </div>
        <div class="feature-card" style="--index: 3">
          <span class="feature-icon" aria-hidden="true">
            <div class="image-icon brain-icon"></div>
          </span>
          <h2>Structured Algorithm + AI</h2>
          <p>Combining structured algorithms with LLMs, Athlethium delivers both reliable and flexible training, with human-like coaching conversations.</p>
        </div>
        <div class="feature-card" style="--index: 4">
          <span class="feature-icon" aria-hidden="true">
            <div class="image-icon money-icon"></div>
          </span>
          <h2>Affordable for All</h2>
          <p>Get world-class, adaptive coaching at a fraction of the cost of traditional coaching, with no compromises.</p>
        </div>
      </div>
    </main>
    
    <footer>
      <div class="footer-content">
        <div class="social-links">
          <a href="https://x.com/athlethium" class="social-link" aria-label="X (formerly Twitter)" target="_blank">
            <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
