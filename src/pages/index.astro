---
// No frontmatter needed for now
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Athlethium</title>
    <meta name="description" content="Affordable, AI-powered adaptive coaching for endurance athletes. Experience a natural coach-like experience with truly personalized, polarized training plans." />
    <link rel="icon" type="image/png" href="/logo.png" />
    <style>
      body {
        font-family: 'Inter', Arial, sans-serif;
        margin: 0;
        background: linear-gradient(135deg, #597391 0%, #42536a 60%, #2a3c52 100%);
        color: #fff;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.8rem 3vw 1rem 3vw;
        margin: 1.2rem 1.2rem 0 1.2rem;
        background: rgba(42, 60, 82, 0.50);
        border-bottom: 1.5px solid #42536a;
        box-shadow: 0 4px 18px 0 rgba(0,0,0,0.18);
        border-radius: 1.2rem 1.2rem 1.2rem 1.2rem;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        font-size: 2.2rem;
        font-weight: bold;
        letter-spacing: 2px;
        color: #fff;
        line-height: 1;
      }
      .logo-img {
        height: 60px;
        width: 60px;
        object-fit: contain;
        display: block;
        margin: 0;
        padding: 0;
        filter: brightness(0) invert(1);
      }
      .header-actions {
        display: flex;
        gap: 1rem;
        align-items: center;
      }
      .register-btn {
        background: #597391;
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 0.75rem 2rem;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        text-decoration: none;
      }
      .register-btn:hover {
        background: #42536a;
        color: #fff;
      }
      .login-btn {
        background: #fff;
        color: #597391;
        border: 2px solid #597391;
        border-radius: 999px;
        padding: 0.75rem 2rem;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, color 0.2s;
        text-decoration: none;
      }
      .login-btn:hover {
        background: #597391;
        color: #fff;
      }
      main {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem 3vw;
      }
      h1 {
        font-size: 2.8rem;
        margin-bottom: 1rem;
        color: #fff;
      }
      .subtitle {
        font-size: 1.3rem;
        color: #b2c7de;
        margin-bottom: 2.5rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
      }
      .features {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        justify-content: center;
        margin-top: 2rem;
      }
      .feature {
        background: rgba(42, 60, 82, 0.30);
        border-radius: 1.2rem;
        padding: 2rem 1.5rem;
        max-width: 320px;
        min-width: 220px;
        box-shadow: 0 2px 16px 0 rgba(0,0,0,0.12);
        border: 1px solid rgba(89,115,145,0.12);
      }
      .feature h2 {
        color: #fff;
        font-size: 1.3rem;
        margin-bottom: 0.7rem;
      }
      .feature p {
        color: #e0eaf6;
        font-size: 1rem;
      }
      footer {
        text-align: center;
        padding: 1.5rem 0 0.5rem 0;
        color: #b2c7de;
        font-size: 0.95rem;
        opacity: 0.7;
      }
      .download-buttons {
        display: flex;
        gap: 1.2rem;
        justify-content: center;
        margin-bottom: 2rem;
      }
      .download-btn {
        display: inline-block;
        padding: 0.85rem 2.2rem;
        border-radius: 999px;
        font-size: 1.1rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s, color 0.2s;
        box-shadow: 0 2px 10px 0 rgba(0,0,0,0.10);
        background: rgba(42, 60, 82, 0.30);
        color: #e0eaf6;
        border: 1px solid rgba(89,115,145,0.12);
      }
      .download-btn:hover {
        background: #42536a;
        color: #fff;
      }
      @media (max-width: 600px) {
        header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          padding: 0.6rem 4vw 0.6rem 4vw;
          margin: 0.7rem 0.7rem 0 0.7rem;
          background: rgba(42, 60, 82, 0.72);
          border-bottom: 1.5px solid #42536a;
          box-shadow: 0 4px 18px 0 rgba(0,0,0,0.18);
          border-radius: 1.2rem 1.2rem 1.2rem 1.2rem;
        }
        main {
          flex: 1;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          padding: 0rem 3vw;
        }
        .logo {
          display: flex;
          align-items: center;
          gap: 0;
        }
        .logo span {
          display: none;
        }
        .logo-img {
          height: 44px;
          width: 44px;
        }
        .header-actions {
          display: flex;
          gap: 0.5rem;
          align-items: center;
        }
        .login-btn, .register-btn {
          padding: 0.5rem 1.1rem;
          font-size: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="logo" style="text-decoration:none;">
        <img src="/logo.png" alt="Logo" class="logo-img" />
        <span>Athlethium</span>
      </a>
      <div class="header-actions">
        <a href="https://app.athlethium.com" class="login-btn">Login</a>
        <a href="https://app.athlethium.com/register" class="register-btn">Register</a>
      </div>
    </header>
    <main>
      <div class="download-buttons">
        <a href="https://testflight.apple.com/join/TWZFZYwX" class="download-btn testflight" target="_blank">Download on TestFlight (iOS)</a>
        <a href="https://github.com/harrycodd/androidAppRepo/releases/download/Athlethium/athlethium-beta.apk" class="download-btn apk" target="_blank">Download APK (Android)</a>
      </div>
      <h1>Adaptive Coaching for Endurance Athletes</h1>
      <div class="subtitle">
        Affordable, AI-powered coaching that adapts to you. Athlethium uses a polarized training model and advanced LLMs to deliver a natural, coach-like experience far beyond static plans or generic LLM advice.
      </div>
      <div class="features">
        <div class="feature">
          <h2>Truly Adaptive</h2>
          <p>Your training plan evolves with you. Athlethium analyzes your progress and feedback, updating your workouts in real time for optimal results.</p>
        </div>
        <div class="feature">
          <h2>Polarized Training</h2>
          <p>Unlike other apps, we use a proven polarized model balancing intensity and recovery for maximum endurance gains and injury prevention.</p>
        </div>
        <div class="feature">
          <h2>Structured Algorithm + AI</h2>
          <p>Combining structured algorithms with LLMs, Athlethium delivers both reliable and flexible training, with human-like coaching conversations.</p>
        </div>
        <div class="feature">
          <h2>Affordable for All</h2>
          <p>Get world-class, adaptive coaching at a fraction of the cost of traditional coaching, with no compromises.</p>
        </div>
      </div>
    </main>
    <footer>
      &copy; 2025 Athlethium. All rights reserved.
    </footer>
  </body>
</html>
