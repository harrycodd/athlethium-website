---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Header from '../components/Header.astro';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Privacy Policy - Athlethium</title>
    <meta name="description" content="Privacy Policy for Athlethium - Learn how we protect your data and privacy." />
    <link rel="icon" type="image/png" href="/website-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      :root {
        --primary: #2563ff;
        --primary-dark: #1a47b8;
        --accent: #6c63ff;
        --accent-secondary: #4F46E5;
        --background-dark: #0a0c12;
        --background-light: #f7faff;
        --card-dark: #141824;
        --card-light: #ffffff;
        --text-dark: #fff;
        --text-light: #0f172a;
        --text-muted-dark: rgba(255, 255, 255, 0.7);
        --text-muted-light: rgba(15, 23, 42, 0.7);
        --border-radius: 18px;
        --shadow: 0 8px 32px -4px rgba(0,0,0,0.15);
        --gradient-primary: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: linear-gradient(145deg, var(--background-dark) 0%, #131726 100%);
        color: var(--text-dark);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-weight: 400;
        min-height: 100vh;
        margin: 0;
        padding: 0;
        transition: background 0.3s, color 0.3s;
        position: relative;
        overflow-x: hidden;
        line-height: 1.6;
        letter-spacing: -0.01em;
      }
      
      body::before {
        content: '';
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: 
          radial-gradient(circle at 15% 25%, rgba(37,99,255,0.07) 0%, transparent 25%),
          radial-gradient(circle at 85% 75%, rgba(108,99,255,0.05) 0%, transparent 30%),
          url('data:image/svg+xml;utf8,<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="1" fill="%232563ff" fill-opacity="0.07"/></svg>');
        opacity: 1;
        z-index: 0;
        pointer-events: none;
      }

      .main-content {
        max-width: 900px;
        margin: 0 auto;
        padding: 120px 24px 60px;
        position: relative;
        z-index: 1;
      }

      .policy-container {
        background: rgba(20, 24, 36, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 40px;
        color: var(--text-dark);
        border: 1px solid rgba(37,99,255,0.08);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
      }

      .policy-header {
        margin-bottom: 40px;
        text-align: center;
      }

      .policy-title {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 10px;
        letter-spacing: -0.02em;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .policy-date {
        color: var(--text-muted-dark);
        font-size: 1.1rem;
        font-weight: 500;
      }

      .policy-content h2 {
        font-size: 1.5rem;
        margin: 30px 0 15px;
        font-weight: 700;
        letter-spacing: -0.01em;
      }

      .policy-content p {
        margin-bottom: 15px;
        line-height: 1.6;
      }

      .policy-content ul {
        margin: 15px 0;
        padding-left: 20px;
      }

      .policy-content li {
        margin-bottom: 8px;
      }

      .back-btn {
        display: inline-flex;
        align-items: center;
        margin-top: 30px;
        color: var(--text-dark);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s;
      }

      .back-btn:hover {
        color: var(--primary);
      }

      .back-btn svg {
        margin-right: 8px;
        width: 20px;
        height: 20px;
      }

      footer {
        padding: 36px 24px;
        font-size: 0.95rem;
        text-align: center;
        background: rgba(14, 18, 28, 0.8);
        color: var(--text-muted-dark);
        backdrop-filter: blur(10px);
        margin-top: 80px;
        border-top: 1px solid rgba(37,99,255,0.08);
      }
      
      .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      
      .footer-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 10px;
      }
      
      .footer-link {
        color: var(--text-muted-dark);
        text-decoration: none;
        transition: color 0.2s;
      }
      
      .footer-link:hover {
        color: var(--primary);
      }

      .social-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 20px;
      }
      
      .social-link {
        color: var(--text-muted-dark);
        font-size: 1.5rem;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
      }
      
      .social-link svg {
        width: 24px;
        height: 24px;
        fill: currentColor;
      }

      /* Light mode support */
      body.light {
        background: linear-gradient(145deg, #f0f5ff 0%, var(--background-light) 100%);
        color: var(--text-light);
      }
      
      body.light::before {
        background: 
          radial-gradient(circle at 15% 25%, rgba(37,99,255,0.05) 0%, transparent 25%),
          radial-gradient(circle at 85% 75%, rgba(108,99,255,0.03) 0%, transparent 30%),
          url('data:image/svg+xml;utf8,<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="1" fill="%232563ff" fill-opacity="0.05"/></svg>');
      }

      body.light .policy-container {
        background: rgba(255, 255, 255, 0.8);
        color: var(--text-light);
      }

      body.light .policy-content {
        color: var(--text-light);
      }

      body.light .policy-date {
        color: var(--text-muted-light);
      }

      body.light .back-btn {
        color: var(--text-light);
      }

      body.light footer {
        background: rgba(247, 250, 255, 0.8);
        color: var(--text-muted-light);
      }
      
      body.light .footer-link {
        color: var(--text-muted-light);
      }

      body.light .social-link {
        color: var(--text-muted-light);
      }

      /* Update media query to match index page */
      @media (max-width: 900px) {
        .main-content {
          margin-top: 100px;
          padding: 0 16px;
        }
      }

      /* Remove redundant header properties from 768px media query */
      @media (max-width: 768px) {
        .policy-container {
          padding: 30px 20px;
        }
        
        .policy-title {
          font-size: 1.8rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />

    <main class="main-content">
      <div class="policy-container">
        <div class="policy-header">
          <h1 class="policy-title">Privacy Policy for Athlethium</h1>
          <div class="policy-date">Effective Date: 12/5/25</div>
        </div>
        
        <div class="policy-content">
          <p>At Athlethium, we are committed to protecting your privacy. This Privacy Policy outlines how we collect, use, and safeguard your information when you use our services as an endurance coach for cycling, running, swimming, or any combination of these activities.</p>
          
          <p>This Privacy Policy should be read in conjunction with our <a href="/terms">Terms and Conditions</a>, which govern your use of the Athlethium platform.</p>
          
          <h2>1. Information We Collect</h2>
          <p>We collect the following types of information from our users:</p>
          <ul>
            <li>
              <strong>Personal Information:</strong> This includes your name and email address, which are necessary for creating and maintaining your account.
            </li>
            <li>
              <strong>Training and Fitness Data:</strong> We collect training data and fitness data from third-party sources (with your explicit consent) to enhance your coaching experience and provide personalized training plans.
            </li>
            <li>
              <strong>Usage Information:</strong> We collect information about how you interact with our platform, including device information, IP address, and usage patterns.
            </li>
            <li>
              <strong>Payment Information:</strong> We utilize third-party payment providers (such as Apple, Google, and Stripe) to process payments securely. We do not directly collect or store your payment information.
            </li>
          </ul>
          
          <h2>2. How We Use Your Information</h2>
          <p>The information we collect is used solely for the following legitimate purposes:</p>
          <ul>
            <li>Providing personalized coaching and training plans that adapt to your progress</li>
            <li>Communicating with you regarding your training and account</li>
            <li>Improving and optimizing our services and user experience</li>
            <li>Ensuring the security and proper functioning of our platform</li>
            <li>Complying with applicable legal obligations</li>
          </ul>
          
          <h2>3. Legal Basis for Processing</h2>
          <p>We process your personal data on the following legal grounds:</p>
          <ul>
            <li>Performance of the contract between you and Athlethium</li>
            <li>Your consent, where explicitly given</li>
            <li>Our legitimate interests in providing and improving our services</li>
            <li>Compliance with legal obligations to which we are subject</li>
          </ul>
          
          <h2>4. Data Sharing</h2>
          <p>We do not sell or rent your personal information to third parties. We may share your data in the following limited circumstances:</p>
          <ul>
            <li>With service providers who perform services on our behalf (such as cloud hosting providers)</li>
            <li>If required by law or legal process</li>
            <li>To protect our rights or property, or the safety of our users</li>
          </ul>
          <p>All third-party service providers are contractually obligated to use your information only as necessary to provide their services to us and in compliance with applicable privacy laws.</p>
          
          <h2>5. User Rights</h2>
          <p>Depending on your location, you may have the following rights regarding your personal information:</p>
          <ul>
            <li>
              <strong>Access:</strong> You can request a copy of the data we hold about you.
            </li>
            <li>
              <strong>Rectification:</strong> You can request correction of inaccurate personal data.
            </li>
            <li>
              <strong>Deletion:</strong> You can request the deletion of your data at any time through the app.
            </li>
            <li>
              <strong>Restriction:</strong> You can request that we restrict processing of your data under certain circumstances.
            </li>
            <li>
              <strong>Data Portability:</strong> You can request your data in a structured, commonly used, and machine-readable format.
            </li>
          </ul>
          <p>To exercise these rights, please contact us using the details provided at the end of this policy.</p>
          
          <h2>6. Data Security</h2>
          <p>We take the security of your data seriously and implement appropriate technical and organizational measures to protect your personal information. We utilize Amazon Web Services (AWS) for cloud storage, ensuring that your data is protected with industry-standard encryption at rest and in transit.</p>
          <p>However, no method of transmission over the Internet or electronic storage is 100% secure. While we strive to use commercially acceptable means to protect your personal information, we cannot guarantee its absolute security.</p>
          
          <h2>7. Data Retention</h2>
          <p>We will retain your personal information only for as long as necessary to fulfill the purposes for which it was collected, including to satisfy any legal, accounting, or reporting requirements. When determining the appropriate retention period, we consider the amount, nature, and sensitivity of the data, as well as the potential risk of harm from unauthorized use or disclosure.</p>
          
          <h2>8. Cookies and Tracking</h2>
          <p>We may use cookies and similar tracking technologies to enhance your experience with our app. These technologies help us understand how users interact with our platform, enabling us to improve our services and provide a better user experience. You can control cookie settings through your browser preferences.</p>
          
          <h2>9. International Data Transfers</h2>
          <p>Your information may be transferred to and processed in countries other than the country in which you reside. These countries may have data protection laws that differ from those in your country. We ensure appropriate safeguards are in place to protect your information when it is transferred internationally.</p>
          
          <h2>10. Children's Privacy</h2>
          <p>Our services are not intended for individuals under the age of 16. We do not knowingly collect personal information from children. If we become aware that we have collected personal information from a child without parental consent, we will take steps to delete that information.</p>
          
          <h2>11. Changes to This Privacy Policy</h2>
          <p>We may update this Privacy Policy from time to time to reflect changes in our practices or legal requirements. We will notify you of any material changes at least two weeks in advance of the effective date of the changes. We encourage you to review this Privacy Policy periodically.</p>
          
          <h2>12. Contact Us</h2>
          <p>If you have any questions or concerns about this Privacy Policy, please contact us at:</p>
          <p>Email: <a href="mailto:support@athlethium.com">support@athlethium.com</a></p>
        </div>
        
        <a href="/" class="back-btn">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
          </svg>
          Back to Home
        </a>
      </div>
    </main>
    
    <footer>
      <div class="footer-content">
        <div class="social-links">
          <a href="https://x.com/athlethium" class="social-link" aria-label="X (formerly Twitter)" target="_blank">
            <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a href="https://instagram.com/athlethium" class="social-link" aria-label="Instagram" target="_blank">
            <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor">
              <path d="M12 2c2.717 0 3.056.01 4.122.06 1.065.05 1.79.217 2.428.465.66.254 1.216.598 1.772 1.153.509.5.902 1.105 1.153 1.772.247.637.415 1.363.465 2.428.047 1.066.06 1.405.06 4.122 0 2.717-.01 3.056-.06 4.122-.05 1.065-.218 1.79-.465 2.428a4.883 4.883 0 01-1.153 1.772c-.5.509-1.105.902-1.772 1.153-.637.247-1.363.415-2.428.465-1.066.047-1.405.06-4.122.06-2.717 0-3.056-.01-4.122-.06-1.065-.05-1.79-.218-2.428-.465a4.89 4.89 0 01-1.772-1.153 4.904 4.904 0 01-1.153-1.772c-.247-.637-.415-1.363-.465-2.428C2.013 15.056 2 14.717 2 12c0-2.717.01-3.056.06-4.122.05-1.066.217-1.79.465-2.428.247-.67.642-1.276 1.153-1.772a4.91 4.91 0 011.772-1.153c.637-.247 1.362-.415 2.428-.465C8.944 2.013 9.283 2 12 2zm0 1.802c-2.67 0-2.986.01-4.04.059-.976.045-1.505.207-1.858.344-.466.182-.8.398-1.15.748-.35.35-.566.684-.748 1.15-.137.353-.3.882-.344 1.857-.048 1.055-.059 1.37-.059 4.04 0 2.67.01 2.986.059 4.04.045.976.207 1.505.344 1.858.182.466.399.8.748 1.15.35.35.684.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.059 4.04.059 2.67 0 2.987-.01 4.04-.059.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.684.748-1.15.137-.353.3-.882.344-1.857.048-1.055.059-1.37.059-4.04 0-2.67-.01-2.986-.059-4.04-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.054-.048-1.37-.059-4.04-.059zm0 3.063a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 8.468a3.333 3.333 0 100-6.666 3.333 3.333 0 000 6.666zm6.538-8.671a1.2 1.2 0 11-2.4 0 1.2 1.2 0 012.4 0z"/>
            </svg>
          </a>
          <a href="mailto:support@athlethium.com" class="social-link" aria-label="Email">
            <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor">
              <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-.4 4.25l-7.07 4.42c-.32.2-.74.2-1.06 0L4.4 8.25a.85.85 0 1 1 .9-1.44L12 11l6.7-4.19a.85.85 0 1 1 .9 1.44z"/>
            </svg>
          </a>
        </div>
        
        <div class="footer-links">
          <a href="/" class="footer-link">Home</a>
          <a href="/privacy" class="footer-link">Privacy Policy</a>
          <a href="/terms" class="footer-link">Terms and Conditions</a>
        </div>
        
        <p>&copy; 2025 Athlethium. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
