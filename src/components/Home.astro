---
import Base from '../layouts/Base.astro';
import PhoneMockup from './PhoneMockup.astro';
import StoreButtons from './StoreButtons.astro';
import { languages, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const f = t.features;
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} detectLanguage={lang === 'en'}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <a href="#features" class="eyebrow pill" data-reveal>
          <span class="dot"></span>
          {t.hero.pill}
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 4l4 4-4 4"></path></svg>
        </a>
        <h1 data-reveal style="--delay: 1">
          {t.hero.titleBefore}<span class="accent">{t.hero.titleAccent}</span>{t.hero.titleAfter}
        </h1>
        <p class="lede" data-reveal style="--delay: 2">{t.hero.lede}</p>
        <div data-reveal style="--delay: 3">
          <StoreButtons lang={lang} />
        </div>
        <ul class="hero-points" data-reveal style="--delay: 4">
          {t.hero.points.map((point) => <li>{point}</li>)}
        </ul>
      </div>

      <div class="hero-visual" data-reveal style="--delay: 2">
        <PhoneMockup lang={lang} />
        <div class="float-card adapt">
          <span class="float-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"></path><path d="M21 3v5h-5"></path></svg>
          </span>
          <div>
            <p>{t.hero.adaptedTitle}</p>
            <small>{t.hero.adaptedBody}</small>
          </div>
        </div>
        <div class="float-card zones">
          <p>{t.hero.thisWeek}</p>
          <div class="split"><span style="--v: 80%"></span><span style="--v: 20%"></span></div>
          <small><b>80%</b> {t.hero.easy} · <b>20%</b> {t.hero.hard}</small>
        </div>
      </div>
    </div>
  </section>

  <!-- Sports strip -->
  <section class="strip" aria-label={t.strip.label}>
    <div class="container strip-inner">
      <span class="strip-label">{t.strip.label}</span>
      <ul>
        {t.strip.sports.map((sport) => <li>{sport}</li>)}
      </ul>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="section">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="kicker">{f.kicker}</p>
        <h2>{f.title}</h2>
        <p>{f.intro}</p>
      </header>

      <div class="bento">
        <article class="tile wide" data-reveal>
          <div class="tile-copy">
            <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg></span>
            <h3>{f.adaptive.title}</h3>
            <p>{f.adaptive.body}</p>
          </div>
          <div class="viz-week" aria-hidden="true">
            {
              [62, 78, 0, 54, 88, 100, 40].map((h, i) => (
                <div class="col">
                  <span class:list={[{ rest: h === 0 }]} style={`--h:${Math.max(h, 8)}%`} />
                  <small>{t.phone.days[i]}</small>
                </div>
              ))
            }
          </div>
        </article>

        <article class="tile" data-reveal style="--delay: 1">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"></path><path d="M7 15l4-4 4 3 5-6"></path></svg></span>
          <h3>{f.polarised.title}</h3>
          <p>{f.polarised.body}</p>
          <div class="viz-zones" aria-hidden="true">
            <span style="--w: 72; background: var(--z2)"></span>
            <span style="--w: 8; background: var(--z3)"></span>
            <span style="--w: 14; background: var(--z4)"></span>
            <span style="--w: 6; background: var(--z6)"></span>
          </div>
        </article>

        <article class="tile" data-reveal>
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a4 4 0 0 0-4 4v1a4 4 0 0 0-3 6.5A4 4 0 0 0 8 21h1V3h3z"></path><path d="M12 3a4 4 0 0 1 4 4v1a4 4 0 0 1 3 6.5A4 4 0 0 1 16 21h-1V3h-3z"></path></svg></span>
          <h3>{f.ai.title}</h3>
          <p>{f.ai.body}</p>
        </article>

        <article class="tile" data-reveal style="--delay: 1">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 6.5h11M6.5 17.5h11M3 9.5v5M21 9.5v5M6.5 4v16M17.5 4v16"></path></svg></span>
          <h3>{f.strength.title}</h3>
          <p>{f.strength.body}</p>
        </article>

        <article class="tile" data-reveal style="--delay: 2">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path><path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path><path d="M3 21v-5h5M21 3v5h-5"></path></svg></span>
          <h3>{f.sync.title}</h3>
          <p>{f.sync.body}</p>
        </article>

        <article class="tile wide reverse" data-reveal>
          <div class="tile-copy">
            <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg></span>
            <h3>{f.language.title}</h3>
            <p>{f.language.body}</p>
          </div>
          <ul class="viz-langs" aria-hidden="true">
            {
              (Object.entries(languages) as [Lang, string][]).map(([code, name]) => (
                <li class:list={[{ current: code === lang }]} lang={code}>{name}</li>
              ))
            }
          </ul>
        </article>

        <article class="tile" data-reveal style="--delay: 1">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M15 9.5c-.5-1-1.6-1.5-3-1.5-1.7 0-3 .8-3 2s1.3 1.7 3 2 3 .9 3 2.1-1.3 1.9-3 1.9c-1.4 0-2.6-.6-3-1.6M12 6v2M12 16v2"></path></svg></span>
          <h3>{f.affordable.title}</h3>
          <p>{f.affordable.body}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="section">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="kicker">{t.how.kicker}</p>
        <h2>{t.how.title}</h2>
      </header>

      <ol class="steps">
        {
          t.how.steps.map((step, i) => (
            <li data-reveal style={`--delay: ${i}`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="container">
      <figure class="founder" data-reveal>
        <span class="icon trophy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z"></path><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"></path></svg></span>
        <blockquote>{t.about.quote}</blockquote>
        <figcaption>{t.about.caption}</figcaption>
      </figure>
    </div>
  </section>

  <!-- Download -->
  <section id="download" class="section">
    <div class="container">
      <div class="cta" data-reveal>
        <div class="cta-glow" aria-hidden="true"></div>
        <h2>{t.cta.title}</h2>
        <p>{t.cta.body}</p>
        <StoreButtons lang={lang} align="center" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: 56px 0 72px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: -68px 0 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    top: 8%;
    right: 12%;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-glow), transparent 65%);
    filter: blur(20px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 48px;
  }

  .hero-copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .pill {
    padding: 6px 12px 6px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-raised);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .pill:hover {
    border-color: var(--border-strong);
  }

  .pill svg {
    width: 14px;
    height: 14px;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    font-weight: 680;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  /* Japanese has no spaces to wrap at, so a slightly smaller headline keeps phrases together. */
  h1:lang(ja) {
    font-size: clamp(2.1rem, 4.4vw, 3.1rem);
    letter-spacing: -0.02em;
  }

  .accent {
    background: linear-gradient(120deg, var(--accent-strong), var(--accent) 60%, #2dd4bf);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lede {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--text-muted);
    max-width: 520px;
  }

  .hero-points {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 0;
    margin: 4px 0 0;
    list-style: none;
    font-size: 14px;
    color: var(--text-muted);
  }

  .hero-points li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hero-points li::before {
    content: '';
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent-soft)
      url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="%2316a34a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 8.2l2.3 2.3 4.7-4.8"/></svg>')
      center / 12px no-repeat;
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 12px 0;
  }

  .float-card {
    position: absolute;
    padding: 12px 14px;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-raised) 88%, transparent);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 13px;
    animation: bob 6s ease-in-out infinite;
  }

  .float-card p {
    font-weight: 600;
    white-space: nowrap;
  }

  .float-card small {
    color: var(--text-muted);
    font-size: 12px;
  }

  /* Cards overlap the phone's edge only, beside the session card and the "Up next" list. */
  .float-card.adapt {
    right: calc(50% + 105px);
    top: 72%;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .float-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .float-icon svg {
    width: 16px;
    height: 16px;
  }

  .float-card.zones {
    left: calc(50% + 115px);
    top: 30%;
    width: 180px;
    display: grid;
    gap: 8px;
    animation-delay: -3s;
  }

  .split {
    display: flex;
    gap: 3px;
    height: 8px;
  }

  .split span {
    width: var(--v);
    border-radius: 4px;
    background: var(--z2);
  }

  .split span + span {
    background: var(--z6);
  }

  .float-card.zones b {
    color: var(--text);
    font-weight: 600;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  /* Sports strip */
  .strip {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .strip-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    min-height: 72px;
    flex-wrap: wrap;
  }

  .strip-label {
    font-size: 13px;
    color: var(--text-subtle);
  }

  .strip ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 40px;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-muted);
  }

  /* Sections */
  .section {
    padding: 112px 0 0;
  }

  .section-head {
    max-width: 680px;
    margin: 0 auto 56px;
    text-align: center;
    display: grid;
    gap: 16px;
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
  }

  .section-head h2 {
    font-size: clamp(2rem, 4.4vw, 3rem);
  }

  .section-head p:not(.kicker) {
    color: var(--text-muted);
    font-size: 1.08rem;
  }

  /* Bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .tile:hover {
    border-color: var(--border-strong);
  }

  .tile.wide {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 28px;
  }

  .tile-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tile h3 {
    font-size: 19px;
    letter-spacing: -0.025em;
    margin-top: 8px;
  }

  .tile p {
    color: var(--text-muted);
    font-size: 15px;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .icon svg {
    width: 20px;
    height: 20px;
  }

  .viz-week {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    align-items: end;
    gap: 8px;
    height: 160px;
    padding: 16px;
    border-radius: var(--radius);
    background: var(--bg-sunken);
  }

  .viz-week .col {
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 6px;
    justify-items: center;
  }

  .viz-week span {
    align-self: end;
    width: 100%;
    height: var(--h);
    border-radius: 6px;
    background: linear-gradient(to top, var(--accent), color-mix(in srgb, var(--accent) 55%, transparent));
  }

  .viz-week span.rest {
    background: var(--border-strong);
  }

  .viz-week small {
    font-size: 11px;
    color: var(--text-subtle);
    font-weight: 600;
  }

  .viz-zones {
    display: flex;
    gap: 3px;
    height: 10px;
    margin-top: auto;
    padding-top: 16px;
    box-sizing: content-box;
  }

  .viz-zones span {
    flex: var(--w) 1 0;
    border-radius: 5px;
  }

  .viz-langs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .viz-langs li {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-sunken);
    font-size: 14px;
    font-weight: 500;
  }

  .viz-langs li.current {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
  }

  /* Steps */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding: 0;
    margin: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 28px 28px 32px;
    border-top: 2px solid var(--border);
    position: relative;
  }

  .steps li::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 48px;
    height: 2px;
    background: var(--accent);
  }

  .num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }

  .steps h3 {
    font-size: 21px;
  }

  .steps p {
    color: var(--text-muted);
  }

  /* Founder */
  .founder {
    margin: 0;
    padding: 56px 48px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background:
      radial-gradient(ellipse 60% 80% at 0% 0%, var(--accent-soft), transparent 70%),
      var(--bg-raised);
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .founder blockquote {
    margin: 0;
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.2;
    max-width: 880px;
    text-wrap: balance;
  }

  .founder figcaption {
    color: var(--text-muted);
  }

  /* CTA */
  .cta {
    position: relative;
    overflow: hidden;
    padding: 80px 24px;
    border-radius: var(--radius-lg);
    background: #0b0b0d;
    color: #fafafa;
    text-align: center;
    display: grid;
    gap: 16px;
    justify-items: center;
    border: 1px solid var(--border);
  }

  .cta-glow {
    position: absolute;
    inset: auto -20% -60% -20%;
    height: 120%;
    background: radial-gradient(ellipse at 50% 100%, rgba(34, 197, 94, 0.35), transparent 60%);
    pointer-events: none;
  }

  .cta h2 {
    position: relative;
    font-size: clamp(2rem, 5vw, 3.2rem);
  }

  .cta p {
    position: relative;
    color: #a1a1aa;
    font-size: 1.08rem;
    margin-bottom: 12px;
  }

  .cta :global(.store-buttons) {
    position: relative;
  }

  .cta :global(.btn-primary) {
    background: #fafafa;
    color: #0b0b0d;
  }

  .cta :global(.btn-secondary) {
    background: rgba(255, 255, 255, 0.06);
    color: #fafafa;
    border-color: rgba(255, 255, 255, 0.16);
  }

  /* Responsive */
  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }

    .hero-copy {
      justify-items: center;
      text-align: center;
    }

    .lede {
      margin: 0 auto;
    }

    .hero-copy :global(.store-buttons),
    .hero-points {
      justify-content: center;
    }

    .bento {
      grid-template-columns: repeat(2, 1fr);
    }

    .steps {
      grid-template-columns: 1fr;
    }
  }

  /* Two columns get tight here: the left card would run into the copy. */
  @media (min-width: 961px) and (max-width: 1180px) {
    .float-card.adapt {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 32px 0 56px;
    }

    .float-card {
      display: none !important;
    }

    .section {
      padding-top: 80px;
    }

    .bento {
      grid-template-columns: 1fr;
    }

    .tile.wide {
      grid-column: auto;
      grid-template-columns: 1fr;
    }

    .tile.wide.reverse .viz-langs {
      order: 2;
    }

    .tile {
      padding: 22px;
    }

    .founder {
      padding: 36px 24px;
    }

    .cta {
      padding: 56px 20px;
    }

    .steps li {
      padding: 24px 4px 8px;
    }
  }
</style>
