---
// A stylised "Today" screen from the app, drawn in HTML so it stays sharp and follows the theme.
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const t = ui[Astro.props.lang].phone;
const intervals = [
  { zone: 2, h: 34, w: 3 },
  { zone: 3, h: 48, w: 2 },
  { zone: 4, h: 72, w: 4 },
  { zone: 2, h: 34, w: 1.5 },
  { zone: 4, h: 72, w: 4 },
  { zone: 2, h: 34, w: 1.5 },
  { zone: 4, h: 72, w: 4 },
  { zone: 5, h: 88, w: 1 },
  { zone: 1, h: 24, w: 3 },
];
const states = ['done', 'today', 'rest', 'planned', 'planned', 'planned', 'planned'];
const week = t.days.map((d, i) => ({ d, state: states[i] }));
---

<div class="phone" aria-hidden="true">
  <div class="screen">
    <div class="status">
      <span>9:41</span>
      <span class="island"></span>
      <span class="status-icons">
        <i></i><i></i><i></i>
      </span>
    </div>

    <div class="app">
      <div class="app-head">
        <div>
          <p class="date">{t.weekday}</p>
          <p class="title">{t.today}</p>
        </div>
        <div class="readiness">
          <svg viewBox="0 0 36 36">
            <circle cx="18" cy="18" r="15" class="track"></circle>
            <circle cx="18" cy="18" r="15" class="value"></circle>
          </svg>
          <span>82</span>
        </div>
      </div>

      <div class="week">
        {
          week.map((day) => (
            <div class:list={['day', day.state]}>
              <span>{day.d}</span>
              <i />
            </div>
          ))
        }
      </div>

      <div class="session">
        <div class="session-top">
          <span class="chip">{t.sport}</span>
          <span class="time">{t.duration}</span>
        </div>
        <p class="session-title">{t.sessionTitle}</p>
        <p class="session-sub">{t.sessionBody}</p>
        <div class="chart">
          {
            intervals.map((b) => (
              <span style={`--h:${b.h}%;--w:${b.w};background:var(--z${b.zone})`} />
            ))
          }
        </div>
        <div class="start">
          <span class="play"></span>
          {t.start}
        </div>
      </div>

      <p class="next-label">{t.upNext}</p>
      <div class="next">
        <div class="row">
          <span class="sport run"></span>
          <div>
            <p>{t.run}</p>
            <small>{t.runWhen}</small>
          </div>
        </div>
        <div class="row">
          <span class="sport strength"></span>
          <div>
            <p>{t.strength}</p>
            <small>{t.strengthWhen}</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .phone {
    --phone-bg: #0c0c0e;
    --phone-card: #18181b;
    --phone-line: rgba(255, 255, 255, 0.08);
    --phone-text: #fafafa;
    --phone-muted: #a1a1aa;
    --phone-accent: #22c55e;
    position: relative;
    width: 300px;
    aspect-ratio: 300 / 620;
    padding: 10px;
    border-radius: 52px;
    background: linear-gradient(145deg, #3f3f46, #18181b 40%, #27272a);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06) inset,
      0 50px 100px -30px rgba(0, 0, 0, 0.55),
      0 30px 60px -30px var(--accent-glow);
  }

  .screen {
    height: 100%;
    border-radius: 42px;
    overflow: hidden;
    background: var(--phone-bg);
    color: var(--phone-text);
    font-size: 12px;
    line-height: 1.35;
  }

  .status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 26px 0;
    font-weight: 600;
    font-size: 12px;
  }

  .island {
    width: 86px;
    height: 24px;
    border-radius: 999px;
    background: #000;
  }

  .status-icons {
    display: flex;
    gap: 3px;
    align-items: flex-end;
  }

  .status-icons i {
    width: 3px;
    border-radius: 1px;
    background: var(--phone-text);
  }

  .status-icons i:nth-child(1) { height: 5px; }
  .status-icons i:nth-child(2) { height: 7px; }
  .status-icons i:nth-child(3) { height: 9px; }

  .app {
    padding: 18px 16px 0;
    display: grid;
    gap: 14px;
  }

  .app-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .date {
    color: var(--phone-muted);
    font-size: 11px;
    font-weight: 500;
  }

  .title {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .readiness {
    position: relative;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 12px;
  }

  .readiness svg {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }

  .readiness circle {
    fill: none;
    stroke-width: 3.5;
  }

  .readiness .track {
    stroke: var(--phone-line);
  }

  .readiness .value {
    stroke: var(--phone-accent);
    stroke-linecap: round;
    stroke-dasharray: 94.2;
    stroke-dashoffset: 17;
  }

  .week {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }

  .day {
    display: grid;
    justify-items: center;
    gap: 5px;
    padding: 7px 0;
    border-radius: 12px;
    color: var(--phone-muted);
    font-size: 10px;
    font-weight: 600;
  }

  .day i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--phone-line);
  }

  .day.done i { background: var(--phone-accent); }
  .day.planned i { background: var(--phone-muted); opacity: 0.6; }
  .day.rest i { background: transparent; }

  .day.today {
    background: var(--phone-accent);
    color: #052e16;
  }

  .day.today i { background: #052e16; }

  .session {
    padding: 14px;
    border-radius: 20px;
    background: var(--phone-card);
    border: 1px solid var(--phone-line);
    display: grid;
    gap: 6px;
  }

  .session-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .chip {
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.14);
    color: #67e8f9;
    font-size: 10px;
    font-weight: 600;
  }

  .time {
    font-family: var(--font-mono);
    color: var(--phone-muted);
    font-size: 11px;
  }

  .session-title {
    font-size: 16px;
    font-weight: 650;
    letter-spacing: -0.02em;
    margin-top: 2px;
  }

  .session-sub {
    color: var(--phone-muted);
    font-size: 11px;
  }

  .chart {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 64px;
    margin: 8px 0 4px;
  }

  .chart span {
    flex: var(--w) 1 0;
    height: var(--h);
    border-radius: 3px 3px 1px 1px;
  }

  .start {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 36px;
    margin-top: 6px;
    border-radius: 999px;
    background: rgba(34, 197, 94, 0.14);
    color: #4ade80;
    font-weight: 650;
    font-size: 12px;
  }

  .play {
    width: 0;
    height: 0;
    border-left: 8px solid currentColor;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
  }

  .next-label {
    color: var(--phone-muted);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 2px;
  }

  .next {
    display: grid;
    gap: 8px;
    margin-top: -6px;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 16px;
    background: var(--phone-card);
    border: 1px solid var(--phone-line);
  }

  .row p {
    font-weight: 600;
  }

  .row small {
    color: var(--phone-muted);
    font-size: 10.5px;
  }

  .sport {
    width: 28px;
    height: 28px;
    border-radius: 9px;
    flex-shrink: 0;
  }

  .sport.run {
    background: rgba(52, 211, 153, 0.16);
    box-shadow: inset 0 0 0 1px rgba(52, 211, 153, 0.3);
  }

  .sport.strength {
    background: rgba(251, 191, 36, 0.16);
    box-shadow: inset 0 0 0 1px rgba(251, 191, 36, 0.3);
  }

</style>
