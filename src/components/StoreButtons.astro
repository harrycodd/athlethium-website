---
interface Props {
  align?: 'start' | 'center';
}
const { align = 'start' } = Astro.props;
---

<div class:list={['store-buttons', align]}>
  <a href="https://testflight.apple.com/join/TWZFZYwX" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.64 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"></path>
    </svg>
    Download for iOS
  </a>
  <a
    href="https://github.com/harrycodd/androidAppRepo/releases/download/Athlethium/athlethium-beta.apk"
    class="btn btn-secondary"
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.6 9.48l1.84-3.18a.38.38 0 0 0-.66-.38l-1.86 3.22a11.4 11.4 0 0 0-9.84 0L5.22 5.92a.38.38 0 0 0-.66.38L6.4 9.48A10.8 10.8 0 0 0 1 18h22a10.8 10.8 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z"></path>
    </svg>
    Download for Android
  </a>
</div>

<style>
  .store-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .store-buttons.center {
    justify-content: center;
  }

  @media (max-width: 480px) {
    .store-buttons {
      flex-direction: column;
    }

    .store-buttons :global(.btn) {
      width: 100%;
    }
  }
</style>
