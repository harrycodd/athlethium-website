---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  effective: string;
}

const { title, description, heading, effective } = Astro.props;
---

<Base title={title} description={description}>
  <article class="container legal">
    <header>
      <a href="/" class="back">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 12L6 8l4-4"></path></svg>
        Back to home
      </a>
      <h1>{heading}</h1>
      <p class="effective">{effective}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    max-width: 760px;
    padding-top: 48px;
    padding-bottom: 40px;
  }

  header {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding-bottom: 32px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--border);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back:hover {
    color: var(--text);
  }

  .back svg {
    width: 16px;
    height: 16px;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
  }

  .effective {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-subtle);
  }

  .prose {
    color: var(--text-muted);
    font-size: 16.5px;
    line-height: 1.75;
  }

  .prose :global(h2) {
    margin: 48px 0 14px;
    font-size: 1.35rem;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .prose :global(p) {
    margin: 0 0 16px;
  }

  .prose :global(ul) {
    margin: 0 0 16px;
    padding-left: 22px;
  }

  .prose :global(li) {
    margin-bottom: 10px;
    padding-left: 4px;
  }

  .prose :global(li::marker) {
    color: var(--accent);
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--accent);
  }
</style>
